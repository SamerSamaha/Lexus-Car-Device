# Store and check out text files with LF line endings on every machine.
# The source is edited on Windows and built in Linux (WSL and the Raspberry Pi).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.mp4 binary
*.pdf binary
