// Car mode (LHU-044): the Pi user may restart the adapter binding unit without a password, so
// that lexus-pair-adapter can apply a new address from SSH or the touchscreen. Nothing else.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "lexus-obd-bind.service" &&
        subject.user == "@USER@") {
        return polkit.Result.YES;
    }
});
