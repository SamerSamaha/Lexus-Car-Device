# Lexus Head Unit car mode: the settings of this one Pi (LHU-044).
# The install script copies this file to ~/.config/lexus-head-unit/car.conf once and never
# overwrites it. That copy holds the adapter address, so it stays on the Pi and is never
# committed (privacy rule). Lines are "key = value"; "#" starts a comment.

[mode]
# car: the adapter in the car. demo: moving demonstration values, no car needed.
# replay: a recorded session, replay_file = last (the newest car session) or a path.
# emulator: the ELM327 emulator on the Pi itself. Switch with: lexus-mode <mode>
kind = car
replay_file = last
replay_timing = original

[adapter]
# Written by lexus-pair-adapter. Empty until the adapter is paired in the car.
address =
# RFCOMM channel of the serial port service of the adapter (assumption A2).
channel = 1
# PIN for legacy pairing; the vLinker default is assumed to be 1234 (assumption A20).
pin = 1234
# Part of the Bluetooth name; the classic side ends in -Android.
name_fragment = vLinker

[session]
# One numbered folder per service start under <data_dir>/sessions/.
data_dir = ~/lexus-data
# Written into the thermal log of every session.
power_source = power bank A1383
thermal_interval_seconds = 5
# off stops the thermal logger.
thermal_log = on

[network]
# The NetworkManager connection of the phone hotspot (docs/release/CAR_DAY_GUIDE.md).
hotspot_connection = hotspot

[display]
# Units on the screen (LHU-050): us (mph, miles, deg F, mpg) or metric (km/h, km, deg C,
# L/100 km). Only the screen changes; the session logs and recordings stay metric.
units = us

[recording]
# Screen recording (LHU-049): on or off. The hub's "Screen recording" tile switches it; it stays
# as set across boots. One .mkv per session (each boot, or each time it is switched on).
enabled = off
directory = ~/lexus-data/screen
# The Wayland output of the touchscreen (kanshi names it DSI-2) and the sound captured with it:
# the monitor of the default output, so the recording has the sound the Pi plays (A24, A25).
output = DSI-2
audio = on
audio_device = @DEFAULT_MONITOR@
framerate = 30
# No new file is started, and a running one is ended, below this much free space.
min_free_mb = 2048
# A full recorder command line with {file} in place of the file name replaces the built-in
# wf-recorder command when set (only if the Pi needs other options).
command =

[phone_link]
# The phone's position for the map (LHU-053): the vehicle-data service serves a page at
# https://<the Pi's address>:<port>/ that Safari opens on the iPhone. on or off. The
# certificates are made by the install script in ~/.config/lexus-head-unit/phone-link/.
enabled = on
port = 8443
