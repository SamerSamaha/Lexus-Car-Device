# User unit for car mode (LHU-049): records the touchscreen and the sound output while
# [recording] enabled = on in ~/.config/lexus-head-unit/car.conf; exits at once when it is off.
# Started by lexus-hub-session at every login, after the Wayland display name has been imported
# into the user manager; stopped and restarted by lexus-screen-record off and on.
[Unit]
Description=Lexus Head Unit screen recorder (car mode)

[Service]
Type=simple
ExecStart=/usr/local/bin/lexus-screen-record run
# A crash of the recorder starts a new file 5 s later; a clean stop (off, or shutdown) does not.
Restart=on-failure
RestartSec=5
# SIGTERM makes the loop stop wf-recorder with SIGINT, which writes the end of the file.
KillMode=mixed
TimeoutStopSec=20
